; The C part is one translation unit: mldsa_stubs.c #includes
; native/mldsa_native_all.c, which includes the vendored
; native/mldsa_native/mldsa_native.c three times (one per parameter set).
; The assembly backends live in mldsa_native_asm.S (see rule below).
;
; Both are compiled with the C compiler of the *active OCaml toolchain* -- so
; `dune build -x solo5` (MirageOS) builds them for the unikernel target, and
; the backend (Neon / AVX2 / portable C) follows from the target compiler's
; predefined macros. Target-specific flags come from gen_arch_flags.ml.
(library
 (name mldsa)
 (public_name mldsa)
 ; gen_arch_flags.ml is a build-time script run by the rule below, NOT a
 ; module of this library (without this line dune would compile it in, and
 ; its top-level Sys.argv access would raise when the .cma is loaded in utop).
 (modules mldsa)
 (foreign_stubs
  (language c)
  (names mldsa_stubs)
  (include_dirs native)
  ; recompile when any vendored source or header changes
  (extra_deps
   (glob_files_rec native/**))
  (flags
   (:standard -O3 -fomit-frame-pointer -std=c99 -Wall -Wextra -Wshadow
    -Wno-unused-function -DNDEBUG
    (:include arch_cflags.sexp))))
 (foreign_archives mldsa_asm))

(rule
 (targets arch_cflags.txt arch_cflags.sexp)
 (action
  (run %{ocaml} %{dep:gen_arch_flags.ml} %{ocaml-config:architecture}
   %{env:MLDSA_ARCH_CFLAGS=} arch_cflags.txt arch_cflags.sexp)))

; Assemble the (level-independent) native backend bundle. It is C-preprocessed,
; so it needs the same config file; the parameter set is irrelevant for the
; shared assembly but our config header insists on one being defined.
(rule
 (targets mldsa_native_asm.o)
 (deps
  (glob_files_rec native/**)
  arch_cflags.txt)
 (action
  (run %{cc} -c -Inative -DNDEBUG "-DMLD_CONFIG_FILE=\"mldsa_ocaml_config.h\""
   -DMLD_CONFIG_PARAMETER_SET=44 -DMLD_CONFIG_MULTILEVEL_WITH_SHARED
   %{read-lines:arch_cflags.txt} native/mldsa_native/mldsa_native_asm.S
   -o %{targets})))

; Package it as a foreign archive (libmldsa_asm.a) so dune links it wherever
; the library is used, including cross-compiled unikernels.
(rule
 (targets libmldsa_asm.a)
 (deps mldsa_native_asm.o)
 (action
  (run ar rcs %{targets} mldsa_native_asm.o)))

; Shared-object twin for bytecode (ocamlrun dlopens dll*.so). Built only when
; the toolchain can produce shared libraries -- the same test dune applies to
; its own dll*_stubs.so, so a solo5 cross context never asks for it.
(rule
 (targets dllmldsa_asm.so)
 (deps mldsa_native_asm.o)
 (enabled_if %{ocaml-config:supports_shared_libraries})
 (action
  (run %{cc} -shared -o %{targets} mldsa_native_asm.o)))
